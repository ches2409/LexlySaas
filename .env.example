# ========================================================
# LEXLY SAAS - CONFIGURACIÓN DE EJEMPLO
# ========================================================
# Copia este archivo a .env y completa con tus valores
# IMPORTANTE: Nunca commitear .env a Git (ya está en .gitignore)
# ========================================================

# ----------------------------------------
# DATABASE - SUPABASE
# ----------------------------------------
# Obtener de: Supabase Dashboard > Settings > API
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ----------------------------------------
# AUTH - JWT
# ----------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=tu-secret-key-generado-aqui
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60 * 24  # 24 horas

# ----------------------------------------
# APP CONFIG
# ----------------------------------------
APP_ENV=development  # development | staging | production
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:3000

# ----------------------------------------
# CORS
# ----------------------------------------
# Origins permitidas (separadas por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ----------------------------------------
# RATE LIMITING (opcional)
# ----------------------------------------
RATE_LIMIT_PER_MINUTE=60